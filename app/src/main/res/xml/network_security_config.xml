<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public URLs are upgraded to HTTPS in code. Cleartext is allowed only so
         localhost/LAN dev servers and the explicit HTTP fallback can work. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/lw_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
