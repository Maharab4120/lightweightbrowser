<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/page_padding">

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:background="@color/brand_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LightweightBrowser"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Fast. Familiar. Yours."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/startSearchBox"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/url_field_background"
            android:contentDescription="Search or type a URL"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Search or type a URL"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shortcut_card_background"
                android:tag="https://www.google.com">

                <ImageView
                    android:layout_width="@dimen/shortcut_icon"
                    android:layout_height="@dimen/shortcut_icon"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Google"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shortcut_card_background"
                android:tag="https://www.youtube.com">

                <ImageView
                    android:layout_width="@dimen/shortcut_icon"
                    android:layout_height="@dimen/shortcut_icon"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/brand_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="YouTube"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shortcut_card_background"
                android:tag="https://github.com">

                <ImageView
                    android:layout_width="@dimen/shortcut_icon"
                    android:layout_height="@dimen/shortcut_icon"
                    android:src="@android:drawable/ic_menu_share"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GitHub"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/shortcut_card_background"
                android:tag="https://www.reddit.com">

                <ImageView
                    android:layout_width="@dimen/shortcut_icon"
                    android:layout_height="@dimen/shortcut_icon"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="@color/brand_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reddit"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

        </GridLayout>
    </LinearLayout>
</ScrollView>
