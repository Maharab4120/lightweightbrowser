<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/shortcut_card_background"
    android:elevation="1dp"
    android:padding="14dp">

    <TextView
        android:id="@+id/shortcutBadge"
        android:layout_width="@dimen/shortcut_icon"
        android:layout_height="@dimen/shortcut_icon"
        android:background="@drawable/shortcut_badge_background"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shortcutLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

</LinearLayout>
