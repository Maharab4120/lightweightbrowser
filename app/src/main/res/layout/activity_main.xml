<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_alt">

    <!-- One omnibox. The submit arrow is attached to its right edge. -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:elevation="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/urlEditText"
            android:layout_width="0dp"
            android:layout_height="@dimen/omnibox_height"
            android:layout_weight="1"
            android:background="@drawable/url_field_background"
            android:drawableStart="@drawable/ic_search"
            android:drawableEnd="@drawable/ic_arrow_forward_accent"
            android:contentDescription="Search or type a URL"
            android:drawablePadding="6dp"
            android:hint="Search or type a URL"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="38dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/newTabButton"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/toolbar_icon_background"
            android:contentDescription="New tab"
            android:drawableStart="@drawable/ic_add"
            android:gravity="center"
            android:padding="0dp"
            android:text=""
            android:textSize="0sp" />

        <TextView
            android:id="@+id/shieldButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:minWidth="84dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/shield_pill_background"
            android:contentDescription="Ad blocking shield. Tap for settings."
            android:drawableStart="@drawable/ic_shield_small"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="Shield On"
            android:textColor="@color/icon_on_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/tabStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:background="@color/brand_primary_dark"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabBarContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Shown only while the page is using the full screen; tap to restore controls. -->
    <ImageButton
        android:id="@+id/chromePeek"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@drawable/peek_background"
        android:contentDescription="Show browser controls"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_expand_more"
        android:visibility="gone" />

    <com.lightweightbrowser.TabSwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.lightweightbrowser.TabSwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:elevation="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:elevation="4dp"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Back"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_back"
            android:gravity="center"
            android:text="Back"
            android:textColor="@color/nav_item_colors"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Forward"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_forward"
            android:gravity="center"
            android:text="Forward"
            android:textColor="@color/nav_item_colors"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/reloadButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Reload"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_reload"
            android:gravity="center"
            android:text="Reload"
            android:textColor="@color/nav_item_colors"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="New tab page"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_home"
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/nav_item_colors"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/downloadButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Download video"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_download"
            android:gravity="center"
            android:text="Save"
            android:textColor="@color/nav_item_colors"
            android:textSize="11sp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
