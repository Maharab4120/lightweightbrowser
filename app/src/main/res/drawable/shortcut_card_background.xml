<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chrome_surface_pressed" />
            <corners android:radius="@dimen/card_radius" />
            <stroke android:width="1dp" android:color="@color/brand_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shortcut_card" />
            <corners android:radius="@dimen/card_radius" />
            <stroke android:width="1dp" android:color="@color/shortcut_card_border" />
        </shape>
    </item>
</selector>
