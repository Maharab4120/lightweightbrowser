<resources>
    <!-- Platform theme only: no Material/AppCompat dependency. -->
    <style name="Base.Theme.LightweightBrowser" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_alt</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/brand_primary_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.LightweightBrowser" parent="Base.Theme.LightweightBrowser" />
</resources>
